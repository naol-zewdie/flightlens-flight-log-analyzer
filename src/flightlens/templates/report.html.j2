<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="FlightLens {{ r.flightlens_version }}">
<title>{{ filename }} · FlightLens report</title>
<style>
:root {
  --bg: #ffffff; --surface: #f6f7f9; --text: #15171a; --text-2: #4b5059; --text-3: #7a808a;
  --line: #e3e6ea; --accent: #2a78d6;
  --problem: #c8372d; --problem-tint: #fbeceb; --attention: #a96a00; --attention-tint: #fdf3e1;
  --ok: #1e8a5a; --ok-tint: #e7f5ee; --neutral-tint: #eef0f3;
  --font: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, "SF Mono", "JetBrains Mono", Consolas, monospace;
}
@media screen and (prefers-color-scheme: dark) {
  :root {
    --bg: #111315; --surface: #181b1f; --text: #eceef1; --text-2: #b4b9c1; --text-3: #858b95;
    --line: #2a2e34; --accent: #6aa8f0;
    --problem: #ef6b62; --problem-tint: #3a1d1b; --attention: #e2a843; --attention-tint: #36290f;
    --ok: #4cc490; --ok-tint: #12301f; --neutral-tint: #22262b;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 var(--font); }
main { max-width: 820px; margin: 0 auto; padding: 32px 16px 64px; }
h1 { font-size: 22px; letter-spacing: -0.01em; margin: 0; overflow-wrap: anywhere; }
h2 { font-size: 15px; margin: 32px 0 10px; letter-spacing: -0.005em; }
h3 { font-size: 14px; margin: 0; }
.eyebrow { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); }
.muted { color: var(--text-2); } .faint { color: var(--text-3); }
.mono { font-family: var(--mono); font-size: 12px; overflow-wrap: anywhere; }
.num { font-variant-numeric: tabular-nums; }
header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; flex-wrap: wrap;
  border-bottom: 1px solid var(--line); padding-bottom: 16px; }
.meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-top: 6px; color: var(--text-2); font-size: 13px; }
.verdict { text-align: right; }
.pill { display: inline-block; padding: 3px 10px; border-radius: 999px; font-weight: 600; font-size: 13px; }
.pill.problem { background: var(--problem-tint); color: var(--problem); }
.pill.attention { background: var(--attention-tint); color: var(--attention); }
.pill.healthy { background: var(--ok-tint); color: var(--ok); }
.pill.neutral, .pill.insufficient { background: var(--neutral-tint); color: var(--text-2); }
.score { font-size: 13px; color: var(--text-2); margin-top: 4px; }
.notice { margin-top: 16px; padding: 10px 12px; border-radius: 8px; background: var(--attention-tint);
  color: var(--text); font-size: 13px; }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 1px;
  background: var(--line); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; margin-top: 20px; }
.stats div { background: var(--bg); padding: 10px 12px; }
.stats .k { font-size: 12px; color: var(--text-3); }
.stats .v { font-size: 16px; font-weight: 600; }
.finding { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; margin-top: 12px;
  break-inside: avoid; page-break-inside: avoid; }
.finding-head { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.sev { font-weight: 600; font-size: 12px; }
.sev.problem { color: var(--problem); } .sev.attention { color: var(--attention); } .sev.error { color: var(--text-2); }
.facts { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13px; color: var(--text-2); margin-top: 4px; }
.finding p { margin: 8px 0 0; }
.rec { color: var(--text-2); }
.rec b { color: var(--text); font-weight: 600; }
.review { margin-top: 10px; padding: 8px 10px; border-radius: 6px; background: var(--surface); font-size: 13px; }
.chart { width: 100%; height: auto; display: block; margin-top: 10px; }
.chart .grid { stroke: var(--line); stroke-width: 1; }
.chart .win { fill: var(--accent); opacity: 0.1; }
.chart .thr { stroke: var(--problem); stroke-width: 1.2; stroke-dasharray: 5 4; }
.chart .ln { stroke-width: 1.3; stroke-linejoin: round; }
.chart text { fill: var(--text-3); font: 10px var(--font); }
.chart .yl { text-anchor: end; } .chart .xl { text-anchor: middle; }
.legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 12px; color: var(--text-2); margin-top: 4px; }
.legend i { display: inline-block; width: 12px; height: 2px; vertical-align: middle; margin-right: 5px; }
.legend .thr-key { border-top: 2px dashed var(--problem); height: 0; }
.legend .unit { margin-left: auto; color: var(--text-3); }
table { width: 100%; border-collapse: collapse; font-size: 13px; }
th { text-align: left; font-weight: 500; color: var(--text-3); font-size: 12px; padding: 6px 8px; border-bottom: 1px solid var(--line); }
td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
tr { break-inside: avoid; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font-size: 12px; padding: 2px 8px; border-radius: 999px; background: var(--ok-tint); color: var(--ok); }
dl { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; margin: 0; font-size: 13px; }
dt { color: var(--text-3); } dd { margin: 0; overflow-wrap: anywhere; }
footer { margin-top: 40px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 12px; color: var(--text-3); }
.print { position: fixed; right: 16px; bottom: 16px; border: 1px solid var(--line); background: var(--bg); color: var(--text);
  padding: 8px 14px; border-radius: 8px; font: 500 13px var(--font); cursor: pointer; box-shadow: 0 2px 8px rgba(0,0,0,.08); }
@media print {
  .print { display: none; }
  main { max-width: none; padding: 0; }
  body { font-size: 11pt; }
  h2 { break-after: avoid; page-break-after: avoid; }
  a { color: inherit; text-decoration: none; }
}
@page { size: A4; margin: 16mm 14mm; }
</style>
</head>
<body>
<main>
  <header>
    <div style="min-width: 0">
      <div class="eyebrow">FlightLens flight report</div>
      <h1>{{ filename }}</h1>
      <div class="meta">
        {% if aircraft %}<span>{{ aircraft }}</span>{% endif %}
        {% if source.vehicle_type %}<span>{{ source.vehicle_type }}</span>{% endif %}
        {% if source.hardware %}<span>{{ source.hardware }}</span>{% endif %}
        {% if source.firmware %}<span>{{ source.firmware }}</span>{% endif %}
        {% if source.start_time %}<span>{{ source.start_time[:16].replace("T", " ") }} UTC</span>{% endif %}
      </div>
    </div>
    <div class="verdict">
      <span class="pill {{ (r.verdict or 'neutral').split(' ')[0] }}">{{ verdict_label }}</span>
      <div class="score">
        {% if r.score is not none %}Health score <b class="num">{{ r.score }}</b>/100{% else %}Not enough data to judge this flight{% endif %}
      </div>
      {% if r.profile %}<div class="score">Thresholds: {{ r.profile.name }}{% if r.profile.source == "learned" and "learned" not in r.profile.name|lower %} (learned){% endif %}</div>{% endif %}
    </div>
  </header>

  {% if stale %}
  <div class="notice">
    This analysis was made by an older version of FlightLens ({{ stale | join("; ") }}).
    Re-analyze the flight for the current result.
  </div>
  {% endif %}

  <div class="stats">
    <div><div class="k">Time in the air</div><div class="v num">{{ summary.airborne_s | duration if summary.sorties else "—" }}</div></div>
    <div><div class="k">Armed</div><div class="v num">{{ summary.duration_s | duration }}</div></div>
    <div><div class="k">Distance</div><div class="v num">{% if summary.distance_m is not none %}{{ summary.distance_m | num }} m{% else %}—{% endif %}</div></div>
    <div><div class="k">Max altitude</div><div class="v num">{% if summary.max_altitude_m is not none %}{{ summary.max_altitude_m | num }} m{% else %}—{% endif %}</div></div>
    <div><div class="k">Battery used</div><div class="v num">{% if summary.battery_used_mah is not none %}{{ summary.battery_used_mah | num }} mAh{% else %}—{% endif %}</div></div>
  </div>
  {% if summary.modes %}<p class="muted" style="font-size: 13px">Flight modes: {{ summary.modes | join(", ") }}</p>{% endif %}

  <h2>Findings{% if findings %} <span class="faint num">· {{ findings | length }}</span>{% endif %}{% if n_reviewed %} <span class="faint">· {{ n_reviewed }} reviewed</span>{% endif %}</h2>
  {% if not findings %}
  <p class="muted">
    {% if r.verdict == "healthy" %}No problems found. Every check that could run passed.{% else %}No problems found, but too few checks could run to call this flight healthy.{% endif %}
  </p>
  {% endif %}
  {% for f in findings %}
  <section class="finding">
    <div class="finding-head">
      <h3>{{ f.title }}</h3>
      <span class="sev {{ f.severity }}">{{ {"problem": "Problem", "attention": "Attention", "error": "Check error"}[f.severity] }}</span>
    </div>
    <div class="facts">
      {% if f.window %}<span class="num">{{ f.window }}</span>{% endif %}
      {% if f.measured is not none %}<span class="num">{{ f.measured | num }} {{ f.unit }}{% if f.threshold is not none %} {{ f.comparison }} {{ f.threshold | num }}{% endif %}</span>{% endif %}
      <span class="mono">{{ f.check_id }}</span>
    </div>
    <p>{{ f.explanation }}</p>
    {% if f.recommendation %}<p class="rec"><b>What to do:</b> {{ f.recommendation }}</p>{% endif %}
    {% if f.chart %}{{ f.chart }}{% endif %}
    {% if f.review %}
    <div class="review"><b>Engineer review: {{ f.review.label }}</b>{% if f.review.note %} — {{ f.review.note }}{% endif %}</div>
    {% endif %}
  </section>
  {% endfor %}

  {% if passed %}
  <h2>Passed</h2>
  <div class="chips">{% for c in passed %}<span class="chip">✓ {{ c.title }}</span>{% endfor %}</div>
  {% endif %}

  {% if not_evaluated %}
  <h2>Not evaluated</h2>
  <table>
    <tbody>
    {% for f in not_evaluated %}
      <tr><td style="width: 34%">{{ f.title | replace(" not evaluated", "") }}</td><td class="muted">{{ f.explanation }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if r.data_quality %}
  <h2>Data quality</h2>
  <table>
    <tbody>
    {% for q in r.data_quality %}
      <tr><td style="width: 22%" class="faint">{{ q.kind | replace("_", " ") }}</td><td>{{ q.message }}{% if q.t is not none %} <span class="faint num">· {{ q.t | time }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}

  <h2>Checks</h2>
  <table>
    <thead><tr><th>Check</th><th>Result</th><th>Version</th></tr></thead>
    <tbody>
    {% for c in r.checks %}
      <tr><td>{{ c.title }} <span class="mono faint">{{ c.id }}</span></td><td>{{ c.status | replace("_", " ") }}</td><td class="mono">{{ c.version }}</td></tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Provenance</h2>
  <dl>
    <dt>Log file</dt><dd>{{ filename }}</dd>
    <dt>SHA-256</dt><dd class="mono">{{ source.sha256 or "—" }}</dd>
    <dt>Format</dt><dd>{{ source.format or "—" }}</dd>
    {% if source.serial %}<dt>Board id</dt><dd class="mono">{{ source.serial }}</dd>{% endif %}
    <dt>Signal mapping</dt><dd class="mono">{{ source.mapping_version or "—" }}</dd>
    <dt>FlightLens</dt><dd class="mono">{{ r.flightlens_version }}</dd>
    <dt>Thresholds</dt><dd>{% if r.profile %}{{ r.profile.name }} <span class="faint">({{ r.profile.source }}, digest <span class="mono">{{ r.profile.digest }}</span>)</span>{% else %}check defaults{% endif %}</dd>
    <dt>Report generated</dt><dd>{{ generated }}</dd>
  </dl>

  <footer>
    Thresholds are community starting values unless a profile is named above; they are not limits approved for this aircraft.
    The original log is unchanged; its SHA-256 identifies it.
  </footer>
</main>
<button class="print" type="button" onclick="window.print()">Print / Save as PDF</button>
</body>
</html>
